rules_version = '2';
// Triangle Splitter security rules. Published automatically on every push to main (.github/workflows/deploy.yml).
// Accounts are plain usernames with no password, so there is no sign-in to check:
// anyone who knows a username (or a bill id) can read and change that data.
service cloud.firestore {
  match /databases/{db}/documents {
    function validName(n) { return n.matches('^[a-z0-9_.-]{3,30}$'); }

    // Profile: saved friends + Venmo/Zelle, keyed by username.
    match /users/{uid} {
      allow read, write: if validName(uid);
      match /joined/{billId} {
        allow read, write: if validName(uid);
      }
    }

    match /bills/{billId} {
      allow create: if validName(request.resource.data.ownerId);
      allow read, delete: if true;
      allow update: if validName(request.resource.data.ownerId);

      match /public/{doc} { allow read, write: if true; }
      match /view/{doc}   { allow read, write: if true; }

      // One doc per friend who joined, keyed by their username.
      match /members/{uid} {
        allow read, delete: if true;
        allow create: if validName(uid)
          && request.resource.data.keys().hasOnly(['name', 'venmo', 'claims', 'iPaid', 'joinedAt']);
        allow update: if true;   // the "finalized" lock is enforced in the app (no way to tell host from friend here)
      }
    }
  }
}

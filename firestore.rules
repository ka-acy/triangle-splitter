rules_version = '2';
// Triangle Splitter security rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }

    // Your profile: saved friends + your Venmo. Only you.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /joined/{billId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /bills/{billId} {
      function isOwner() {
        return signedIn() && get(/databases/$(db)/documents/bills/$(billId)).data.ownerId == request.auth.uid;
      }
      function locked() {
        return get(/databases/$(db)/documents/bills/$(billId)/public/menu).data.get('locked', false) == true;
      }

      // The full bill (everyone's amounts): host only.
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;

      // Item list friends see when they open the link (no names, no amounts).
      match /public/{doc} {
        allow read: if signedIn();
        allow write: if isOwner();
      }

      // One doc per friend who joined. A friend can read only their own.
      match /members/{uid} {
        allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'venmo', 'claims', 'iPaid', 'joinedAt']);
        allow update: if isOwner() || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'venmo', 'claims', 'iPaid'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['claims']) || !locked()));
        allow delete: if isOwner();
      }
    }
  }
}
